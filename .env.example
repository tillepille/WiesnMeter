# WiesnMeter Configuration

# Domain & Traefik Configuration
DOMAIN=wiesnmeter.yourdomain.com
TRAEFIK_NETWORK=traefik-net               # Name of the external docker network Traefik uses
TRAEFIK_ENTRYPOINT=websecure              # Entrypoint in Traefik for HTTPS traffic (e.g. websecure or https)
TRAEFIK_CERT_RESOLVER=letsencrypt         # Name of your Traefik ACME / Let's Encrypt certificate resolver

# Application Host & Security
PORT=3000
HOSTNAME=https://wiesnmeter.yourdomain.com
SESSION_SECRET=generate-a-strong-random-secret-here
COOKIE_SECURE=true
DEV_MODE=false

# GitHub OAuth / App Credentials
# Create at: https://github.com/settings/developers
# Callback URL to configure on GitHub:
# https://wiesnmeter.yourdomain.com/login/github/callback
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# OpenTelemetry Configuration
OTEL_SERVICE_NAME=wiesnmeter
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318/v1/metrics
OTEL_METRICS_EXPORTER=both                 # options: otlp, console, both
OTEL_METRIC_EXPORT_INTERVAL=5000           # export interval in ms
